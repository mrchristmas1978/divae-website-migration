    {
     "role": "body",
     "order": 0,
     "text": "Connect Processes, Data & Customers"
    },
    {
     "role": "heading",
     "order": 1,
     "text": "Customer Relationship Management (CRM)"
    },
    {
     "role": "body",
     "order": 2,
     "text": "Customer relationships are key to sustainable business success – and the right CRM technology is the lever to manage these relationships in a targeted, effective way. A modern CRM helps you unify customer processes, leverage data strategically, and shape interactions that are personal, efficient, and scalable. Whether it's acquisition, retention, or service – a powerful CRM brings transparency to your processes and drives better business outcomes."
    },
    {
     "role": "cta",
     "order": 3,
     "text": "Get expert advice",
     "href": "/en/services/crm/#form"
    }
   ],
   "imgCount": 0,
   "editableTexts": 2,
   "repeats": []
  },
