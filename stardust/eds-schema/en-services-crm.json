   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Our CRM-Services"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Strategy & Concept Design"
    },
    {
     "role": "body",
     "order": 2,
     "text": "Strategy & Concept Design"
    },
    {
     "role": "body",
     "order": 3,
     "text": "Comprehensive assessment of your current system landscape and business objectives, development of a clear, future-proof CRM vision, and value-driven process design with a strong customer focus, including detailed customer journey mapping."
    },
    {
     "role": "body",
     "order": 4,
     "text": "System Analysis & Migration"
    },
    {
     "role": "body",
     "order": 5,
     "text": "System Analysis & Migration"
    },
    {
     "role": "body",
     "order": 6,
     "text": "In-depth system and data assessment, security evaluation, data health checks, transition planning, and structured migration including rigorous testing and go-live support."
    },
    {
     "role": "body",
     "order": 7,
     "text": "Implementation & Customization"
    },
    {
     "role": "body",
     "order": 8,
     "text": "Implementation & Customization"
    },
    {
     "role": "body",
     "order": 9,
     "text": "Technical configuration, tailored development, interface and quality management, plus the integration of AI-powered solutions designed specifically for your CRM."
    },
    {
     "role": "body",
     "order": 10,
     "text": "Rollout & User Adoption"
    },
    {
     "role": "body",
     "order": 11,
     "text": "Rollout & User Adoption"
    },
    {
     "role": "body",
     "order": 12,
     "text": "Training concepts, establishment of key-user and super-user structures, change communication, and continuous rollout support to ensure sustainable adoption."
    },
    {
     "role": "body",
     "order": 13,
     "text": "Compliance & Security"
    },
    {
     "role": "body",
     "order": 14,
     "text": "Compliance & Security"
    },
    {
     "role": "body",
     "order": 15,
     "text": "Leveraging our extensive experience, we support the technical implementation of compliance and data protection requirements within your CRM system."
    },
    {
     "role": "body",
     "order": 16,
     "text": "Please note: We do not provide legal advice."
    },
    {
     "role": "body",
     "order": 17,
     "text": "Salesforce Expertise"
    },
    {
     "role": "body",
     "order": 18,
     "text": "Salesforce Expertise"
    },
    {
     "role": "body",
     "order": 19,
     "text": "As an experienced we support you in making optimal use of the platform—from tailor-made implementation and individual customization to integration into your existing system landscape—in order to achieve maximum value creation."
    },
    {
     "role": "cta",
     "order": 20,
     "text": "Salesforce partner,",
     "href": "/en/about-us/partner/salesforce/"
    }
