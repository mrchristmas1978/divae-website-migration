   "section": "simple-text",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Your CRM Strategy – Aligned with Growth"
    },
    {
     "role": "body",
     "order": 1,
     "text": "A CRM system lays the foundation to manage customer relationships effectively, streamline processes, and strengthen your business in the long term. Here’s what you can achieve:"
    }
   ],
