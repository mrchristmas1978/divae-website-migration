    {
     "role": "body",
     "order": 0,
     "text": "Conclusion Connect"
    },
    {
     "role": "heading",
     "order": 1,
     "text": "Turning AI Vision into Business Value"
    },
    {
     "role": "body",
     "order": 2,
     "text": "One day. 150+ leaders. One clear focus: turning AI into results."
    },
    {
     "role": "body",
     "order": 3,
     "text": "Conclusion Connect brings together decision-makers, digital leaders, and top technology partners for a curated day of strategic exchange, real-world insights, and high-quality networking. If you're serious about making AI work for your business - this is where you need to be."
    },
    {
     "role": "body",
     "order": 4,
     "text": "📍 Van der Valk Hotel Düsseldorf"
    },
    {
     "role": "body",
     "order": 5,
     "text": "📅 September 17, 2026"
    },
    {
     "role": "cta",
     "order": 6,
     "text": "Register now",
     "href": "/en/connect/#form"
    }
   ],
